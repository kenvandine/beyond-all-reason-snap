#!/bin/sh
# chrome-sandbox is removed at build time (it needs setuid, which strict
# snaps can't grant), so Chromium/Electron must run unsandboxed instead.
# Data/config/cache are redirected into SNAP_USER_COMMON (not
# SNAP_USER_DATA, which is per-revision and gets wiped/replaced on every
# refresh) since bar-lobby downloads the multi-GB Recoil engine and game
# content under XDG_DATA_HOME and we don't want that re-fetched on every
# snap update.
export HOME="$SNAP_USER_COMMON"
export XDG_CONFIG_HOME="$SNAP_USER_COMMON/.config"
export XDG_DATA_HOME="$SNAP_USER_COMMON/.local/share"
export XDG_CACHE_HOME="$SNAP_USER_COMMON/.cache"
mkdir -p "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME"

# Electron/Chromium defaults to the X11 Ozone backend even on pure-Wayland
# systems, where there's no Xwayland; force Wayland when a compositor
# socket is available, otherwise let it fall back to X11 automatically.
# This base has no host-provided XKB keymap data (it's a Wayland-only
# device image), so bundle xkb-data (see the bar-lobby part) and point
# libxkbcommon at it directly.
export XKB_CONFIG_ROOT="$SNAP/usr/share/X11/xkb"

if [ -n "$WAYLAND_DISPLAY" ]; then
    set -- --ozone-platform=wayland --enable-features=WaylandWindowDecorations "$@"
else
    set -- --ozone-platform-hint=auto "$@"
fi

# AppArmor only allows this snap to use /dev/shm/snap.beyond-all-reason.**,
# but Chromium's default shared-memory files are named
# /dev/shm/.org.chromium.Chromium.*, which doesn't match and gets denied.
# --disable-dev-shm-usage makes it use /tmp (private per-snap) instead.
exec "$SNAP/bar-lobby" --no-sandbox --disable-dev-shm-usage "$@"
